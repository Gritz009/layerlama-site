# Layer Lama — Portfolio Admin (local-only)
# Copy this file to .env and fill in real values. .env is gitignored.

# Notion internal integration token. Create one at:
#   https://www.notion.so/profile/integrations
# Then share the "Portfolio Projects" database with the integration:
#   1. Open https://www.notion.so/e3709cae61b541e0820d507d5c63c304
#   2. Click "..." → "Connections" → add your integration
NOTION_TOKEN=

# Portfolio DB ID (already known — leave as default unless the DB moves)
NOTION_PORTFOLIO_DB_ID=e3709cae-61b5-41e0-820d-507d5c63c304

# Optional — change if port 3000 is in use
PORT=3000

# Netlify build tracking — lets the admin show live build status (red → orange → green).
# 1. Create a personal access token at https://app.netlify.com/user/applications
# 2. Get NETLIFY_SITE_ID from your site's Site configuration → General → Site information
# Leave both blank to skip — the publish flow still works, just without live status.
NETLIFY_TOKEN=
NETLIFY_SITE_ID=
